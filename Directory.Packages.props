<Project>
  <!-- Gestione centralizzata delle versioni: i .csproj citano solo il nome del pacchetto. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Accessibilità: interop COM puro IL, identico su x64 e ARM64 (verificato in docs/research/probe-office.md) -->
    <PackageVersion Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <!-- Audio: ramo 2.x maturo, interamente gestito, misurato nativo ARM64 (docs/research/elevenlabs-tts.md, sez. 6.4) -->
    <PackageVersion Include="NAudio" Version="2.4.0" />
    <!-- Segreti: DPAPI -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- Elaborazione immagini GDI+ per il pre-trattamento OCR (solo strato Windows) -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
    <!-- OCR ONNX (PaddleOCR) -->
    <PackageVersion Include="RapidOcrNet" Version="4.2.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
